# Copiar este archivo como .env y llenar con los datos de
# Supabase > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-llave-anon-publica

# La usa el servidor para guardar cada clasificación en transacciones y para vincular usuarios con botes (/api/vincular).
# Supabase > Project Settings > API > service_role. NUNCA la subas a git ni la pongas en la página.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-service-role
# id (tabla botes) del bote al que está conectada esta cámara
BOTE_ID=1
# La cámara y el modelo arrancan con la app. 0 = no arrancarlos (p. ej. en un servidor sin cámara)
INICIAR_CAMARA=1
# Índice de la cámara (si la 0 no responde se prueba la 1)
CAMARA=0
# Servir con https (certificado propio en certs/) para usar la cámara en vivo desde el celular. 0 = http normal
HTTPS=1
