# Copiar este archivo como .env y llenar con los datos de
# Supabase > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-llave-anon-publica

# La usa el servidor para guardar cada clasificación en transacciones y para vincular usuarios con botes (/api/vincular).
# Supabase > Project Settings > API > service_role. NUNCA la subas a git ni la pongas en la página.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-service-role
# id (tabla botes) del bote al que está conectada esta cámara. Solo se usa cuando no hay sesión activa:
# con sesión, la transacción va al usuario y al bote de esa sesión.
BOTE_ID=7
# Segundos tras cada residuo detectado para que el bote rote y abra la compuerta; mientras, no se cuenta otro
ESPERA_DEPOSITO=6
# La cámara y el modelo arrancan con la app. 0 = no arrancarlos (p. ej. en un servidor sin cámara)
INICIAR_CAMARA=1
# Índice de la cámara (si la 0 no responde se prueba la 1)
CAMARA=0
# 1 = servir con https y un certificado propio (certs/, el navegador avisa "no seguro"). Mejor usar un túnel:
#     cloudflared tunnel --url http://localhost:5000
HTTPS=0
